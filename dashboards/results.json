    },
    {
      "id": 4,
      "type": "row",
      "title": "Broken panels",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "Broken panels (in time range)",
      "description": "Every panel that showed Grafana's red error icon in the time range, with how many scans it failed in. Click a panel to open it. Error is empty unless the checker runs with CHECKER_INCLUDE_ERROR_TEXT=true.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "expr": "sum by (folder, dashboard_title, panel_title, tab, error, link) (count_over_time($stream | json | event=\"panel_failed\" [$__range]))",
          "queryType": "instant",
          "editorMode": "code",
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "folder": 0,
              "dashboard_title": 1,
              "panel_title": 2,
              "tab": 3,
              "Value #A": 4,
              "error": 5
            },
            "renameByName": {
              "folder": "Folder",
              "dashboard_title": "Dashboard",
              "panel_title": "Panel",
              "tab": "Tab",
              "Value #A": "Scans failed in",
              "error": "Error"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Scans failed in",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          },
          "noValue": ""
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Panel"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open the panel",
                    "url": "${__data.fields.link}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "link"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Scans failed in"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 130
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
