    {
      "type": "timeseries",
      "title": "Scan duration",
      "description": "How long each scan took: its slowest shard. Compare it with CHECKER_BROWSER_TIMEOUT_SECONDS: a scan that runs out of time leaves dashboards unchecked.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "expr": "$stream | json | event=\"scan_complete\"",
          "queryType": "range",
