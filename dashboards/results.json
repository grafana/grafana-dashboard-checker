      "type": "table",
      "title": "Slowest dashboards (in time range)",
      "description": "The 10 dashboards that took longest to check in the time range (their slowest scan). Many tabs or slow queries; see CHECKER_BROWSER_DASHBOARD_TIMEOUT_SECONDS.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "expr": "topk(10, max by (folder, dashboard_title, link) (max_over_time($stream | json | event=\"dashboard_checked\" | unwrap duration_s | __error__=\"\" [$__range])))",
          "queryType": "instant",
          "editorMode": "code",
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "folder": 0,
              "dashboard_title": 1,
              "Value #A": 2
            },
            "renameByName": {
              "folder": "Folder",
              "dashboard_title": "Dashboard",
              "Value #A": "Duration"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Duration",
                "desc": true
              }
            ]
          }
