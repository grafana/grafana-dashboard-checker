      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "expr": "$stream | json | event=\"scan_complete\"",
          "queryType": "range",
          "editorMode": "code",
          "maxLines": 5000
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "Line",
            "format": "json",
            "replace": false,
            "keepTime": false
          }
