      "type": "row",
      "title": "Needs attention",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "Not fully checked (in time range)",
      "description": "Dashboards the checker couldn't check fully in the time range: the page never loaded, it was only partly checked (time limit or an error part-way), or a panel was still loading at the settle cap.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "expr": "sum by (event, reason, folder, dashboard_title, link) (count_over_time($stream | json | event=~\"dashboard_load_failed|dashboard_incomplete|dashboard_unsettled\" [$__range]))",
          "queryType": "instant",
          "editorMode": "code",
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "event": 0,
              "reason": 1,
              "folder": 2,
              "dashboard_title": 3,
              "Value #A": 4
            },
            "renameByName": {
              "event": "Problem",
              "reason": "Reason",
              "folder": "Folder",
              "dashboard_title": "Dashboard",
              "Value #A": "Scans"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Scans",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": ""
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Dashboard"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open the dashboard",
                    "url": "${__data.fields.link}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "link"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Problem"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 120
              },
              {
